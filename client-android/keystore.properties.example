# Android release 签名配置示例
#
# 用法：复制本文件为 client-android/keystore.properties（与 settings.gradle.kts 同级），
#      再填入你自己的签名信息。keystore.properties 和 *.jks 都不要提交到仓库。
# 没有 keystore.properties 时，Gradle 仍可编译 release，但产物是未签名的 APK。
# storeFile：相对 client-android/ 目录的路径（也可以写绝对路径）
storeFile=app/keystore/homing-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=homing
keyPassword=CHANGE_ME_KEY_PASSWORD