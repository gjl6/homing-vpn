# 归途（Homing）网关配置模板
# 复制为 .env 后再修改：cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Docker 镜像命名（发布到镜像仓库时使用）
# 本地构建：HOMING_IMAGE_PREFIX 留空；镜像名 = homing:1.0.0
# 发布/拉取：HOMING_IMAGE_PREFIX=yourname/；镜像名 = yourname/homing:1.0.0
# ---------------------------------------------------------------------------
HOMING_IMAGE_PREFIX=
HOMING_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 隧道
# ---------------------------------------------------------------------------
# 隧道监听端口（隧道核心 + 打洞中继目标 + IPv6 直连端口都跟随它）
# 路由器/云安全组需要放行该 UDP 端口
CORE_PORT=51820

# 隧道内健康探针回显端口（客户端可配置探测参数；这里只改服务端监听端口）
PROBE_PORT=51824

# 下发给客户端的 DNS（经隧道访问，通常填家里路由器地址）
CORE_DNS=192.168.1.1

# 家里/办公室局域网网段（管理台生成「只回内网」客户端时使用）
CORE_LAN=192.168.1.0/24

# 隧道内客户端网段（core 的 -v4cidr 默认值）；出口按这个网段识别客户端源地址
CLIENT_NET=10.8.0.0/24

# ---------------------------------------------------------------------------
# 管理台
# ---------------------------------------------------------------------------
# 首次启动用于初始化管理员账户，至少 16 位；之后以管理台账户 / 2FA 为准
ADMIN_PASSWORD=

# 管理台监听地址（host 网络）。默认所有网卡；只想本机访问可改成 127.0.0.1:51822
ADMIN_LISTEN=:51822

# 项目部署目录的绝对路径（管理台在容器内通过 docker compose 重建隧道核心时使用）
# 必须与 docker-compose.yml 所在目录一致
VPN_HOST_DIR=/opt/homing

# 可选出口在管理台「出口」页配置（本机 TUN / 远程代理），不需要改 .env。

# ---------------------------------------------------------------------------
# 构建镜像（可选）：Go 模块代理
# 默认 proxy.golang.org；国内 / 受限网络改成 https://goproxy.cn,direct
# ---------------------------------------------------------------------------
# GO_PROXY=https://goproxy.cn,direct
