# 归途（Homing）网关配置模板
# 复制为 .env 后再修改：cp .env.example .env && chmod 600 .env
#
# 所有变量都是可选的：
#   - 有环境变量 → 使用环境变量
#   - 没有 → 管理台设置 / 自动探测 / 内置默认
# 首次启动管理员密码默认 admin123（不设置 ADMIN_PASSWORD 时），登录后请立即修改。

# ---------------------------------------------------------------------------
# Docker 镜像命名（发布到镜像仓库时使用）
# 本地构建：HOMING_IMAGE_PREFIX 留空；镜像名 = homing:1.2.5
# 发布/拉取：HOMING_IMAGE_PREFIX=yourname/；镜像名 = yourname/homing:1.2.5
# ---------------------------------------------------------------------------
HOMING_IMAGE_PREFIX=
HOMING_VERSION=1.2.5

# ---------------------------------------------------------------------------
# 管理台
# ---------------------------------------------------------------------------
# 首次启动初始化管理员；不填默认 admin123，登录后请到「设置」改密码
# ADMIN_PASSWORD=admin123

# 管理台监听地址（host 网络）。默认 :51822；只想本机访问可改成 127.0.0.1:51822
# ADMIN_LISTEN=:51822

# ---------------------------------------------------------------------------
# 隧道（一般不需要改，管理台「设置 → 网络与默认值」可改）
# ---------------------------------------------------------------------------
# 隧道监听 UDP 端口（路由器/云安全组需要放行）
# CORE_PORT=51820

# 隧道内探针回显端口（0=关闭）
# PROBE_PORT=51824

# 下发给客户端的 DNS；留空自动取默认网关
# CORE_DNS=

# 家里/办公室局域网网段；留空自动按默认路由网卡探测
# CORE_LAN=

# 隧道客户端网段；留空使用 10.8.0.0/24
# CLIENT_NET=

# 打洞端口；留空/0 = 每次启动随机，也可在管理台随时更换
# 也可以写固定端口数字（如 51830）或 127.0.0.1:0 形式
# STUN_PORT=

# ---------------------------------------------------------------------------
# 数据目录
# ---------------------------------------------------------------------------
# 所有状态（core.json / admin.json / stun/ / egress 等）都在这个目录
# HOMING_DATA_DIR=./data
# 容器通过 DAC_OVERRIDE 读写该目录，属主不需要是固定 UID；数据目录会原样保留在宿主机上。

# ---------------------------------------------------------------------------
# 构建镜像（可选）：Go 模块代理
# 默认 proxy.golang.org；国内 / 受限网络改成 https://goproxy.cn,direct
# ---------------------------------------------------------------------------
# GO_PROXY=https://goproxy.cn,direct
